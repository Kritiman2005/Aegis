# ─── Models & DB ─────────────────────────────────────────
*.gguf
*.bin
*.db
*.sqlite3
qdrant_db/
backend/qdrant_db/
# Runtime marker — set once app.core.rag.processor.migrate_documents_to_current_embedding
# has run for this local install, not part of the app itself.
backend/.embedding_v2_migrated
# Whisper model — downloaded by scripts/download_whisper_model.py at build
# time (see app/core/transcription.py), not committed.
backend/app/whisper_bundled/
# Playwright's Chromium binary — downloaded on demand into AEGIS_DATA_DIR
# normally (see app/core/scraper.py), but falls back to this repo-root path
# when AEGIS_DATA_DIR isn't set (e.g. running the backend directly outside
# Electron) — never committed either way.
browsers/
# Portable Node.js / uv runtimes auto-downloaded for MCP servers whose
# command (npx/uvx) isn't already installed — same AEGIS_DATA_DIR-or-repo-
# root fallback as browsers/ above (see app/mcp/runtime_manager.py).
backend/runtimes/
# Repos cloned by the GitHub-install connector flow — same AEGIS_DATA_DIR-or-
# repo-root fallback (see app/mcp/github_installer.py).
backend/connector_repos/
# Whisper model — downloaded by scripts/download_whisper_model.py at build
# time (see app/core/transcription.py), not committed.
backend/app/whisper_bundled/
# Playwright's Chromium binary — downloaded on demand into AEGIS_DATA_DIR
# normally (see app/core/scraper.py), but falls back to this repo-root path
# when AEGIS_DATA_DIR isn't set (e.g. running the backend directly outside
# Electron) — never committed either way.
browsers/

# ─── Environment Variables ───────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── macOS ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─── IDE / Editor ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Logs ───────────────────────────────────────────────
logs/
*.log

# ─── Assets ─────────────────────────────────────────────
# assets/icon.* was previously listed here as "generated", but nothing in
# this repo actually generates them — they're the real, manually-produced
# app icon (electron-builder's mac/win/linux `icon` config points straight
# at these three files). Ignoring them meant a fresh `actions/checkout` on
# CI (build-windows.yml) never had them, so electron-builder silently fell
# back to its own default Electron icon in every CI-built .exe — must be
# committed for the real Aegis icon to ever reach a packaged build.
uploads/

# ─── Bundled OAuth credentials (auto-generated by CI — never commit) ─────────
backend/app/config/credentials.py

# ─── macOS code-signing certificate ──────────────────────────────────────────
# The Developer ID Application .p12 used to sign/notarize release builds
# (see .github/workflows/build-mac.yml) lives only as a base64 GitHub Actions
# secret (CSC_LINK) — never as a file in this repo, which is public.
*.p12
*.pfx

backend/venv2/
backend/test_httpx.spec
