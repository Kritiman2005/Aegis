{
  "name": "aegis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis — Local-first, privacy-focused AI agent desktop platform",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:next": "next dev --turbo",
    "dev:backend": "cd backend && PYTHONDONTWRITEBYTECODE=1 uvicorn main:app --reload --reload-dir app --reload-exclude '*.db*' --reload-exclude '*.sqlite*' --port 8000",
    "dev:electron": "tsc -p electron/tsconfig.json && electron .",
    "dev": "concurrently -n \"NEXT,BACKEND\" -c \"cyan,green\" \"npm run dev:next\" \"npm run dev:backend\"",
    "build:next": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:python": "cd backend && python scripts/download_whisper_model.py && pyinstaller main.spec",
    "build": "next build && tsc -p electron/tsconfig.json && npm run build:python && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.aegis.desktop",
    "productName": "Aegis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/main",
        "to": "backend"
      },
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "packaging/mac/entitlements.mac.plist",
      "entitlementsInherit": "packaging/mac/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "afterRemove": "packaging/linux/after-remove.sh"
    }
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.25.0",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^7.2.0"
  }
}
