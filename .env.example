# ══════════════════════════════════════════════════════════════════════════════
#  Aegis — Environment Variables
#  Copy this file to .env and fill in your credentials.
#  Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Google OAuth (required for Google Workspace connector) ───────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Slack OAuth App ───────────────────────────────────────────────────────────
# Get from: https://api.slack.com/apps  →  Create new app  →  "Blank app" (Do NOT use AI agent or Starter app)
# Setup: 1. OAuth & Permissions → Add Redirect URL: http://localhost:8000/auth/slack/callback → Add Bot Scopes
#        2. Basic Information → Copy Client ID & Client Secret
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Notion OAuth App ──────────────────────────────────────────────────────────
# Get from: https://www.notion.so/my-integrations  →  Connections  →  Authentication method
# Setup: Select "OAuth" (User-scoped OAuth 2.0). Do NOT use "Access token".
# Redirect URI: http://localhost:8000/auth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Get from: https://github.com/settings/applications/new
# Application name: Aegis
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8000/auth/github/callback
# Setup: Click "Register application" → Generate a new client secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── HubSpot OAuth App ─────────────────────────────────────────────────────────
# Get from: https://app.hubspot.com/developer-docs  →  Create App  →  Auth
# Redirect URL: http://localhost:8000/auth/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Linear OAuth App ──────────────────────────────────────────────────────────
# Get from: https://linear.app/settings/api  →  OAuth Applications  →  New
# Redirect URL: http://localhost:8000/auth/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ── Airtable OAuth App ────────────────────────────────────────────────────────
# Get from: https://airtable.com/create/oauth  →  Register new integration
# Redirect URL: http://localhost:8000/auth/airtable/callback
# Note: Airtable requires PKCE — handled automatically by Aegis.
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

# ── Atlassian (Jira) OAuth App ────────────────────────────────────────────────
# Get from: https://developer.atlassian.com/console/myapps/  →  Create app
# → Authorization  →  Add URL  →  Redirect: http://localhost:8000/auth/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ── Salesforce Connected App ──────────────────────────────────────────────────
# Get from: Salesforce Setup  →  App Manager  →  New Connected App  →  Enable OAuth
# Redirect URL: http://localhost:8000/auth/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Stripe (API key — no OAuth needed) ───────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ── Shopify (Admin API token — no standard OAuth for server access) ───────────
# Get from: Shopify Admin  →  Settings  →  Apps & sales channels  →  Custom App
SHOPIFY_ACCESS_TOKEN=

# ── Brave Search API ──────────────────────────────────────────────────────────
# Get from: https://brave.com/search/api/
BRAVE_API_KEY=

# ── Google Maps API ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# ── Zendesk (API token — OAuth varies by plan) ────────────────────────────────
# Get from: Zendesk Admin Center  →  Apps & integrations  →  APIs  →  Add token
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=
ZENDESK_SUBDOMAIN=

# ── Sentry (developer tool) ───────────────────────────────────────────────────
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# ── Elasticsearch (developer tool) ────────────────────────────────────────────
ES_URL=
ES_API_KEY=
