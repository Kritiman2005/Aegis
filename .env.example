# ══════════════════════════════════════════════════════════════════════════════
#  Aegis — Environment Variables
#  Copy this file to .env and fill in your credentials.
#  Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── OAuth connectors (Google, Slack, Notion, GitHub, HubSpot, Linear, ────────
#    Airtable, Jira, Salesforce) ───────────────────────────────────────────────
# Aegis has no hosted OAuth broker and runs no shared app on anyone's behalf.
# Each of these is configured per-user, inside the app: open Connectors,
# click Configure on the service, and paste in your own OAuth client ID and
# secret (registered with that provider under your own account). Nothing to
# set here in .env — see backend/app/mcp/catalog.py's setup_hint per entry
# for the exact redirect URI each provider's app needs.

# ── Stripe (API key — no OAuth needed) ───────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ── Shopify (Admin API token — no standard OAuth for server access) ───────────
# Get from: Shopify Admin  →  Settings  →  Apps & sales channels  →  Custom App
SHOPIFY_ACCESS_TOKEN=

# ── Brave Search API ──────────────────────────────────────────────────────────
# Get from: https://brave.com/search/api/
BRAVE_API_KEY=

# ── Google Maps API ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# ── Zendesk (API token — OAuth varies by plan) ────────────────────────────────
# Get from: Zendesk Admin Center  →  Apps & integrations  →  APIs  →  Add token
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=
ZENDESK_SUBDOMAIN=

# ── Sentry (developer tool) ───────────────────────────────────────────────────
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# ── Elasticsearch (developer tool) ────────────────────────────────────────────
ES_URL=
ES_API_KEY=
